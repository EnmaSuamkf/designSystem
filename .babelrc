{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react"
  ],
  "plugins": [
    ["module-resolver", {
      "root": ["./"],
      "alias": {
        "./src": "./src",
        "^~(.*)": "./src/\\1"
      }
    }],
    [
      "babel-plugin-styled-components",
      {
        "displayName": true,
        "fileName": false,
        "preprocess": false,
        "minify": true,
        "transpileTemplateLiterals": true,
        "pure": true
      }
    ]
  ]
}